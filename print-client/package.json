    "dist:win": "npm run build && electron-builder --win --ia32 --x64 --publish never"
  },
  "dependencies": {
    "@bwip-js/generic": "^4.11.4",
    "element-plus": "^2.8.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  }
}
