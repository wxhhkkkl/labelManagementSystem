# ---------------------------------------------------------------------------
# 应用运行所需的配置。复制为 .env 后填写真实值；.env 不得提交到仓库。
#
# 注意：本文件**只列应用会读取的键**。部署与建库用的服务器凭据
# （SERVER_IP / SERVER_USER / SERVER_PASSWRD / MYSQL_DB_SERVER_USER /
#   MYSQL_DB_SERVER_PASSWRD）不属于应用配置，应用进程不会读取它们。
# ---------------------------------------------------------------------------

# ---- MySQL（应用连接用，建议使用最小权限账号）----
MYSQL_DB_SERVER=
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=labelManagementSystemDB
MYSQL_DB_USER=
MYSQL_DB_PSW=
MYSQL_DB_CHARSET=utf8mb4

# 可选：直接给整串连接串，优先于上面的拆分项
# DATABASE_URL_OVERRIDE=mysql+pymysql://user:pass@host:3306/labelManagementSystemDB?charset=utf8mb4

# ---- 测试库（集成/契约测试专用，会被清空重建）----
# 库名 MUST 含 "test"，且 MUST NOT 与 MYSQL_DB_NAME 相同。
# 不设置时，所有需要数据库的测试会被跳过。
# TEST_DATABASE_URL=mysql+pymysql://user:pass@host:3306/labelManagementSystemDB_test?charset=utf8mb4

# ---- 认证 ----
# 生产环境必须替换为随机值，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- 可调参数（按需覆盖）----
# PRINT_LOCK_TIMEOUT_SECONDS=300
# HEARTBEAT_INTERVAL_SECONDS=5
# OFFLINE_THRESHOLD_SECONDS=30
