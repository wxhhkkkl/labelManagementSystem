{
  "name": "lms-print-client",
  "version": "0.1.0",
  "private": true,
  "description": "打印管理系统 - 工位软件（Electron）",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
